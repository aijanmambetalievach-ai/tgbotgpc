# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real tokens or passwords.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Token issued by @BotFather. Required.
BOT_TOKEN=123456789:AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRr

# --- Bootstrap ------------------------------------------------------------
# Comma-separated Telegram user IDs that are promoted to ADMIN on startup.
# Admins receive new applications and manage courses, lessons and the FAQ.
# Find your ID with @userinfobot.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=123456789

# --- Database -------------------------------------------------------------
# Async SQLAlchemy DSN used by the application.
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender
# Optional: separate database used by integration tests. Integration tests are
# skipped automatically when this is not set.
# TEST_DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Application ----------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# `json` for production log shipping, `console` for readable local output.
LOG_FORMAT=console

# Timezone used for every user-facing date. Storage is always UTC.
APP_TIMEZONE=Asia/Bishkek

# Shown in the greeting and in exported file names.
BRAND_NAME=Тендер Академия

# --- HTTP API (health checks / future web admin) --------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set to false to run the Telegram bot without the HTTP server.
API_ENABLED=true

# --- Limits ---------------------------------------------------------------
MAX_MESSAGE_LENGTH=4000
MAX_TITLE_LENGTH=300
# Longest lesson / description / FAQ answer / message, in characters.
MAX_TEXT_LENGTH=3500
# How many unanswered applications one client may have at a time.
MAX_OPEN_APPLICATIONS=10
PAGE_SIZE=8

# --- Anti-spam ------------------------------------------------------------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=10
