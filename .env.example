# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real tokens or passwords.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Token issued by @BotFather. Required.
BOT_TOKEN=123456789:AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRr

# --- Bootstrap ------------------------------------------------------------
# Comma-separated Telegram user IDs that are promoted to TENDER_EMPLOYEE on
# startup. Used only to seed the very first employee; afterwards authorization
# is fully database-driven.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=123456789

# --- Database -------------------------------------------------------------
# Async SQLAlchemy DSN used by the application.
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender
# Optional: separate database used by integration tests. Integration tests are
# skipped automatically when this is not set.
# TEST_DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Application ----------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# `json` for production log shipping, `console` for readable local output.
LOG_FORMAT=console

# Timezone used for every user-facing date. Storage is always UTC.
APP_TIMEZONE=Asia/Bishkek
# Time applied when an employee provides a deadline date without a time.
DEFAULT_DEADLINE_TIME=18:00

# --- HTTP API (health checks / future web admin) --------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set to false to run the Telegram bot without the HTTP server.
API_ENABLED=true

# --- Limits ---------------------------------------------------------------
MAX_ITEMS_PER_REQUEST=500
MAX_ITEM_NAME_LENGTH=300
MAX_COMMENT_LENGTH=2000
MAX_PROCUREMENT_TITLE_LENGTH=300
MAX_PROCUREMENT_DESCRIPTION_LENGTH=5000
MAX_MESSAGE_LENGTH=4000
MAX_PARTICIPANTS_PER_PROCUREMENT=1000
PREVIEW_ITEMS_LIMIT=30
PAGE_SIZE=8
# Uploaded Excel lists: size cap and how many rows are scanned.
MAX_UPLOAD_SIZE_BYTES=5000000
MAX_UPLOAD_ROWS=5000

# --- Anti-spam ------------------------------------------------------------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=10

# --- Invites --------------------------------------------------------------
INVITE_TTL_HOURS=72
